---
import Layout from "../layouts/Layout.astro";
import client from "../../tina/__generated__/client";

const result = await client.queries.pricing({ relativePath: "tarifs.json" });
const data = result.data.pricing;
---

<Layout title="Tarifs">
  <section class="text-center mb-10">
    <h1 class="text-3xl font-bold text-slate-900 sm:text-4xl">Nos tarifs</h1>
    <p class="mt-3 text-lg text-slate-600">Choisissez la formule adaptée à vos besoins</p>
  </section>

  <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {data.tiers?.map((tier) => (
      <div class="flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-md">
        <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-full bg-blue-100 text-blue-600 font-bold">
          {tier.number}
        </div>
        <h2 class="text-xl font-semibold text-slate-900">{tier.title}</h2>
        {tier.highlight && (
          <p class="mt-2 text-sm text-slate-600">{tier.highlight}</p>
        )}
        <div class="mt-auto pt-6">
          <a
            href="#contact"
            class="block rounded-lg bg-blue-600 px-4 py-2 text-center text-sm font-medium text-white transition hover:bg-blue-700"
          >
            Nous contacter
          </a>
        </div>
      </div>
    ))}
  </div>

  {data.footnote && (
    <p class="mt-10 text-center text-sm text-slate-500">{data.footnote}</p>
  )}
</Layout>
