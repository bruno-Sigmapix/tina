---
import Layout from "../layouts/Layout.astro";
import PageContent from "../components/PageContent";
import client from "../../tina/__generated__/client";

const result = await client.queries.page({ relativePath: "home.mdx" });
const page = result.data.page;
---

<Layout title={page.title} metaDescription={page.metaDescription ?? undefined}>
  <PageContent client:load query={result.query} variables={result.variables} data={result.data} />
</Layout>
